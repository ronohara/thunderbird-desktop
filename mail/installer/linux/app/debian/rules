#!/usr/bin/make -f

%:
	dh $@

override_dh_strip_nondeterminism:
	dh_strip_nondeterminism -Xxpi

# Package for the oldest supported distribution, not for the build host.
#
# dh_shlibdeps derives Depends from whatever machine runs the repackage. Build
# on Ubuntu 24.04 (noble) and the .deb names 24.04's t64 libraries and 24.04's
# version floors, so it refuses to install on 22.04 (jammy) even though the
# binary runs there -- measured, 345 glib symbols required and none missing.
#
# The package is a repackage: mach takes an already-built tarball and wraps it.
# The binary is built against Mozilla's own sysroot, so its real floors are old
# (libc6 2.34, libstdc++6 11 -- jammy has 2.35 and GCC 12). What is left is a
# statement about a distribution, and it should be the oldest one supported.
#
# Why the old names rather than the t64 ones: on noble, libglib2.0-0t64
# Provides libglib2.0-0, so a package asking for the old name installs on both.
# The reverse is not true -- jammy's libglib2.0-0 does not provide
# libglib2.0-0t64. Naming the old packages makes one artifact work on jammy and
# on noble. If Ubuntu ever drops those Provides, this returns to a real problem
# and per-distribution builds become necessary.
#
# Two floors are deliberately relaxed, both traced to something the binary does
# not need:
#   libglib2.0-0 >= 2.77.3 -> 2.72: noble tags g_unix_open_pipe at 2.77.3, but
#       glib's own header declares it GLIB_AVAILABLE_IN_2_30 (2011).
#   libx11-xcb1 >= 2:1.8.7 -> no floor: noble emits one blanket line for every
#       binary that links the library; the only function used here,
#       XGetXCBConnection, is present in jammy's 2:1.7.5.
#
# Maintained by hand, so keep it honest: the derived list is preserved as a
# comment below, and the repackage should fail if a new library appears that
# this list does not name.
#
# Derived on noble (Ubuntu 24.04), 2026-10-23, for reference:
#   libasound2t64 (>= 1.0.27), libatk1.0-0t64 (>= 1.12.4), libc6 (>= 2.34),
#   libcairo-gobject2 (>= 1.10.0), libcairo2 (>= 1.10.0),
#   libdbus-1-3 (>= 1.9.14), libfontconfig1 (>= 2.12.6),
#   libfreetype6 (>= 2.3.9), libgcc-s1 (>= 4.2),
#   libgdk-pixbuf-2.0-0 (>= 2.22.0), libglib2.0-0t64 (>= 2.77.3),
#   libgtk-3-0t64 (>= 3.13.7), libnspr4 (>= 2:4.12), libnss3 (>= 2:3.94),
#   libpango-1.0-0 (>= 1.14.0), libpangocairo-1.0-0 (>= 1.14.0),
#   libstdc++6 (>= 11), libx11-6, libx11-xcb1 (>= 2:1.8.7), libxcb-shm0,
#   libxcb1, libxcomposite1 (>= 1:0.4.5), libxcursor1 (>> 1.1.2),
#   libxdamage1 (>= 1:1.1), libxext6, libxfixes3 (>= 1:5.0), libxi6,
#   libxrandr2 (>= 2:1.4.0), libxrender1

DEB_OLD_DEPENDS = libasound2 (>= 1.0.27), \
	libatk1.0-0 (>= 1.12.4), \
	libc6 (>= 2.34), \
	libcairo-gobject2 (>= 1.10.0), \
	libcairo2 (>= 1.10.0), \
	libdbus-1-3 (>= 1.9.14), \
	libfontconfig1 (>= 2.12.6), \
	libfreetype6 (>= 2.3.9), \
	libgcc-s1 (>= 4.2), \
	libgdk-pixbuf-2.0-0 (>= 2.22.0), \
	libglib2.0-0 (>= 2.72), \
	libgtk-3-0 (>= 3.13.7), \
	libnspr4 (>= 2:4.12), \
	libnss3 (>= 2:3.94), \
	libpango-1.0-0 (>= 1.14.0), \
	libpangocairo-1.0-0 (>= 1.14.0), \
	libstdc++6 (>= 11), \
	libx11-6, \
	libx11-xcb1, \
	libxcb-shm0, \
	libxcb1, \
	libxcomposite1 (>= 1:0.4.5), \
	libxcursor1 (>> 1.1.2), \
	libxdamage1 (>= 1:1.1), \
	libxext6, \
	libxfixes3 (>= 1:5.0), \
	libxi6, \
	libxrandr2 (>= 2:1.4.0), \
	libxrender1

# Substituted for ${shlibs:Depends} by dh_gencontrol, in place of what
# dh_shlibdeps would have written.
override_dh_gencontrol:
	dh_gencontrol -- -Vshlibs:Depends="$(DEB_OLD_DEPENDS)"
