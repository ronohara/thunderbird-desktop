From 375e6d11f01c196dda674dcf2117f2056c775148 Mon Sep 17 00:00:00 2001
From: Ron OHara <rono.ohara54@gmail.com>
Date: Sun, 25 Oct 2026 04:15:35 +0700
Subject: [PATCH] Allow adding a subkey to a certify-only primary key

PGP_OP_ADD_SUBKEY required can_sign(), which excluded keys whose primary
carries only the certify flag -- the structure `gpg --quick-generate-key ...
cert` produces and GnuPG recommends, so the certificate key can be kept
offline while everyday signing happens on a rotatable subkey.

A subkey binding signature is a certification, not a data signature: RFC 4880
s5.2.3.21 gives certify and sign separate bits, and `gpg --quick-add-key`
adds subkeys to such a key without difficulty.

Nothing below this check requires the ability to sign. Key::add_sub_binding,
Key::sign_subkey_binding and Key::sign_binding each verify only that the
caller is a primary key, and sign_binding calls signature_calculate directly
with no capability test at all. The refusal was one predicate naming the
wrong capability.

can_sign() is kept alongside can_certify() so the change only admits keys
that were previously refused; a caller that signs with a key which does not
certify continues to work.
---
 src/lib/key.cpp       |  9 +++++++-
 src/tests/ffi-key.cpp | 54 +++++++++++++++++++++++++++++++++++++++++++
 2 files changed, 62 insertions(+), 1 deletion(-)

diff --git a/src/lib/key.cpp b/src/lib/key.cpp
index 5162d78b..c5e3b6f1 100644
--- a/src/lib/key.cpp
+++ b/src/lib/key.cpp
@@ -968,7 +968,14 @@ Key::usable_for(pgp_op_t op, bool if_secret) const
 {
     switch (op) {
     case PGP_OP_ADD_SUBKEY:
-        return is_primary() && can_sign() && (if_secret || has_secret());
+        /* A subkey binding signature is a certification, not a data
+         * signature: RFC 4880 s5.2.3.21 gives certify and sign separate bits,
+         * and a certify-only primary is the structure GnuPG recommends so the
+         * certificate key can stay offline. Testing can_sign() alone refused
+         * those keys. can_sign() is still accepted so nothing that worked
+         * before stops working. */
+        return is_primary() && (can_certify() || can_sign()) &&
+               (if_secret || has_secret());
     case PGP_OP_SIGN:
         return can_sign() && valid() && (if_secret || has_secret());
     case PGP_OP_CERTIFY:
diff --git a/src/tests/ffi-key.cpp b/src/tests/ffi-key.cpp
index 9010999c..76085f43 100644
--- a/src/tests/ffi-key.cpp
+++ b/src/tests/ffi-key.cpp
@@ -646,6 +646,60 @@ TEST_F(rnp_tests, test_ffi_key_generate_misc)
     assert_rnp_success(rnp_ffi_destroy(ffi));
 }
 
+TEST_F(rnp_tests, test_ffi_key_generate_certify_only_primary)
+{
+    rnp_ffi_t ffi = NULL;
+    assert_rnp_success(rnp_ffi_create(&ffi, "GPG", "GPG"));
+
+    /* A certify-only primary, as `gpg --quick-generate-key ... cert` produces.
+     * clear_usage is needed first because add_usage only adds to the
+     * algorithm's default set, so an ECDSA primary would otherwise also be
+     * able to sign. */
+    rnp_op_generate_t op = NULL;
+    assert_rnp_success(rnp_op_generate_create(&op, ffi, "ECDSA"));
+    assert_rnp_success(rnp_op_generate_set_curve(op, "NIST P-256"));
+    assert_rnp_success(rnp_op_generate_set_userid(op, "certify-only"));
+    assert_rnp_success(rnp_op_generate_clear_usage(op));
+    assert_rnp_success(rnp_op_generate_add_usage(op, "certify"));
+    assert_rnp_success(rnp_op_generate_set_expiration(op, 0));
+    assert_rnp_success(rnp_op_generate_execute(op));
+    rnp_key_handle_t primary = NULL;
+    assert_rnp_success(rnp_op_generate_get_key(op, &primary));
+    rnp_op_generate_destroy(op);
+
+    bool flag = true;
+    assert_rnp_success(rnp_key_allows_usage(primary, "certify", &flag));
+    assert_true(flag);
+    flag = true;
+    assert_rnp_success(rnp_key_allows_usage(primary, "sign", &flag));
+    assert_false(flag);
+
+    /* Adding a signing subkey must succeed: the binding signature is a
+     * certification, and this primary can certify. */
+    rnp_op_generate_t subop = NULL;
+    assert_rnp_success(rnp_op_generate_subkey_create(&subop, ffi, primary, "ECDSA"));
+    assert_rnp_success(rnp_op_generate_set_curve(subop, "NIST P-256"));
+    assert_rnp_success(rnp_op_generate_add_usage(subop, "sign"));
+    assert_rnp_success(rnp_op_generate_set_expiration(subop, 0));
+    assert_rnp_success(rnp_op_generate_execute(subop));
+    rnp_key_handle_t subkey = NULL;
+    assert_rnp_success(rnp_op_generate_get_key(subop, &subkey));
+    rnp_op_generate_destroy(subop);
+
+    /* and the primary's own usage did not widen as a side effect */
+    flag = true;
+    assert_rnp_success(rnp_key_allows_usage(primary, "sign", &flag));
+    assert_false(flag);
+
+    bool issub = false;
+    assert_rnp_success(rnp_key_is_sub(subkey, &issub));
+    assert_true(issub);
+
+    rnp_key_handle_destroy(subkey);
+    rnp_key_handle_destroy(primary);
+    assert_rnp_success(rnp_ffi_destroy(ffi));
+}
+
 TEST_F(rnp_tests, test_ffi_sec_key_offline_operations)
 {
     rnp_ffi_t ffi = NULL;
